# Gemini AI
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public app URL
APP_URL="https://your-domain.example"

# Production auth secret: random, 32+ characters
JWT_SECRET=

# Optional first admin bootstrap (remove from environment after account creation)
KITA_BOOTSTRAP_ADMIN_EMAIL=
KITA_BOOTSTRAP_ADMIN_PASSWORD=
KITA_BOOTSTRAP_ADMIN_NAME=KITA Administrator

# Email delivery (Resend HTTP API)
# EMAIL_FROM must be an address/domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM="KITA <noreply@your-verified-domain.example>"

# Authorized official job feed(s), comma-separated if more than one.
# Feed response may be an array, {"jobs":[...]}, or {"data":[...]}.
# Each item must include: id/source_id, title, company_name/company, city,
# publication_date/published_at, and a direct public listing URL (url/original_listing_url).
KITA_OFFICIAL_FEED_URL=
KITA_OFFICIAL_FEED_URLS=
KITA_OFFICIAL_FEED_TOKEN=
KITA_OFFICIAL_FEED_TIMEOUT_MS=15000

# Google Sign-In (Web OAuth client)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
