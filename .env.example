# NOVA API
PORT=10000
DATABASE_URL=
FRONTEND_ORIGIN=https://your-nova-domain.example
NODE_ENV=production

# Authorized real job feed. NOVA refuses to seed fabricated vacancies.
NOVA_JOB_FEED_URL=
# Long random secret required by POST /api/admin/jobs/sync; keep it private.
NOVA_SYNC_SECRET=

# Optional frontend API base. Leave empty when frontend and API share an origin.
VITE_API_BASE_URL=

# Optional email delivery provider configuration for future verification/recovery flows.
NOVA_EMAIL_PROVIDER_URL=
NOVA_EMAIL_PROVIDER_API_KEY=
NOVA_EMAIL_FROM=noreply@your-verified-domain.example

# Optional geocoding/commute provider. NOVA never invents travel times when unset.
NOVA_GEOCODING_URL=
NOVA_GEOCODING_API_KEY=
