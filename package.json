{
  "name": "nova-career-platform",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs",
    "sync:jobs": "node scripts/sync-jobs.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/nova.test.mjs tests/server-smoke.test.mjs tests/job-sync.test.mjs",
    "check": "npm run typecheck && npm test && node --check server/index.mjs",
    "test:db": "node --experimental-strip-types --test tests/server-db.integration.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "pg": "^8.16.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
